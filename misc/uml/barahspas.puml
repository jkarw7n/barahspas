@startuml BaraHSPAS

title BSIT 2H-G1 Group A\nFinal Examination/Final Project in IT 203 (Object-Oriented Programming)\nBarangay Health Station Patient and Appointment System

interface Identifiable {
    + {abstract} int getId()
    + {abstract} void setId(int id)
}

abstract class Person implements Identifiable {
    - int id
    - String firstName
    - String middleName
    - String lastName
    - String nameSuffix
    - String mobileNumber
    - String emailAddress
    __
    # Person()
    # Person(String firstName, String middleName,\nString lastName, String nameSuffix, String\nmobileNumber, String emailAddress)
    .. Getters ..
    + int getId()
    + String getFirstName()
    + String getMiddleName()
    + String getLastName()
    + String getNameSuffix()
    + String getMobileNumber()
    + String getEmailAddress()
    .. Setters ..
    + void setId(int id)
    + void setFirstName(String firstName)
    + void setMiddleName(String middleName)
    + void setLastName(String lastName)
    + void setNameSuffix(String nameSuffix)
    + void setMobileNumber(String mobileNumber)
    + void setEmailAddress(String emailAddress)
    .. Other Methods ..
    - String capitalizeName(String name)
}

abstract class MedicalStaff extends Person {
    - String licenseNumber
    - String employmentType
    - String shiftSchedule
    __
    # MedicalStaff()
    # MedicalStaff(String firstName, String middleName,\nString lastName, String nameSuffix, String\nmobileNumber, String emailAddress, String\nlicenseNumber, String employmentType, String\nshiftSchedule)
    .. Getters ..
    + String getLicenseNumber()
    + String getEmploymentType()
    + String getShiftSchedule()
    .. Setters ..
    + void setLicenseNumber(String licenseNumber)
    + void setEmploymentType(String employmentType)
    + void setShiftSchedule(String shiftSchedule)
    .. Other Methods ..
    + {abstract} boolean canDiagnoseAndPrescribe()
}

class Doctor extends MedicalStaff {
    - String specialization
    __
    + Doctor()
    + Doctor(String firstName, String middleName,\nString lastName, String nameSuffix, String\nmobileNumber, String emailAddress, String\nlicenseNumber, String employmentType,\nString shiftSchedule, String specialization)
    .. Getters ..
    + String getSpecialization()
    .. Setters ..
    + void setSpecialization(String specialization)
    .. Other Methods ..
    + boolean canDiagnoseAndPrescribe()
}

class Nurse extends MedicalStaff {
    - String assignedProgram
    __
    + Nurse()
    + Nurse(String firstName, String middleName, String\nlastName, String nameSuffix, String mobileNumber,\nString emailAddress, String licenseNumber, String\nemploymentType, String shiftSchedule, String\nassignedProgram)
    .. Getters ..
    + String getAssignedProgram()
    .. Setters ..
    + void setAssignedProgram(String assignedProgram)
    .. Other Methods ..
    + boolean canDiagnoseAndPrescribe()
}

class Patient extends Person {
    - LocalDate birthDate
    - String sex
    - SortedMap<LocalDate, String> medicalRecords
    __
    + Patient()
    + Patient(String firstName, String middleName, String\nlastName, String nameSuffix, String mobileNumber,\nString emailAddress, LocalDate birthDate, String sex)
    .. Getters ..
    + LocalDate getBirthDate()
    + String getSex()
    + SortedMap<LocalDate, String> getMedicalRecords()
    .. Setters ..
    + void setBirthDate(LocalDate birthDate)
    + void setSex(String sex)
    + void setMedicalRecords(SortedMap<LocalDate,\nString> medicalRecords)
    .. Other Methods ..
    + long getAge()
}

class Appointment implements Identifiable {
    - int id
    - MedicalStaff medicalStaff
    - Patient patient
    - LocalDate date
    - LocalTime startTime
    - LocalTime endTime
    - String status
    - String diagnosis
    - String prescription
    - String notes
    __
    + Appointment(MedicalStaff medicalStaff, Patient\npatient, LocalDate date, LocalTime startTime,\nLocalTime endTime)
    .. Getters ..
    + int getId()
    + MedicalStaff getMedicalStaff()
    + Patient getPatient()
    + LocalDate getDate()
    + LocalTime getStartTime()
    + LocalTime getEndTime()
    + String getStatus()
    + String getDiagnosis()
    + String getPrescription()
    + String getNotes()
    .. Setters ..
    + void setId(int id)
    + void setMedicalStaff(MedicalStaff medicalStaff)
    + void setPatient(Patient patient)
    + void setDate(LocalDate date)
    + void setStartTime(LocalTime startTime)
    + void setEndTime(LocalTime endTime)
    + void setStatus(String status)
    + void setDiagnosis(String diagnosis)
    + void setPrescription(String prescription)
    + void setNotes(String notes)
}

